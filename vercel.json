{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/ingest/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/events/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/aggregates/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/(.*\\.(png|jpg|jpeg|css|js))",
            "dest": "public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "public/index.html"
        }
    ]
}